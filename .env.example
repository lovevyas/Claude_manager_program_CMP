# Required: your Anthropic API key (https://console.anthropic.com). Never commit the real one.
ANTHROPIC_API_KEY=
# Optional
PORT=3000
GRADER_MODEL=claude-opus-5-5
# Per-IP submissions allowed per hour (protects your API key on a public deployment)
RATE_LIMIT_PER_HOUR=20
# Set to "off" to disable the server-side refusal fallback
GRADER_FALLBACKS=
